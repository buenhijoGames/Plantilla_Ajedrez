    <!-- Acerca de -->
    <string name="info_acerca_titulo">Acerca de la app</string>
    <string name="info_acerca_descripcion">Plantilla_ajedrez es una aplicación gratuita y sin publicidad diseñada para que los jugadores de ajedrez anoten sus partidas mientras las juegan, las guarden en formato interoperable y las compartan con otros jugadores o plataformas.</string>
    <string name="info_acerca_objetivo">Su objetivo es ampliar el conocimiento ajedrecístico de los usuarios, facilitando el registro sistemático de partidas en torneos, matches o partidas sueltas.</string>

    <!-- Cómo funciona -->
    <string name="info_como_titulo">Cómo funciona</string>
    <string name="info_paso1">1. Al abrir la app, elige crear un nuevo torneo/match o abrir uno guardado.</string>
    <string name="info_paso2">2. En el torneo, pulsa \"+\" para crear partidas. Entra en cada partida para jugarla.</string>
    <string name="info_paso3">3. Toca las casillas del tablero para anotar jugadas (origen → destino).</string>
    <string name="info_paso4">4. La planilla se actualiza automáticamente con la notación PGN estándar.</string>
    <string name="info_paso5">5. Usa el menú de 3 puntos para exportar PDF (plantilla FIDE) o PGN.</string>
    <string name="info_paso6">6. En modo edición (botón ✏️), añade comentarios, símbolos de evaluación y variantes jugando en el tablero.</string>

    <!-- Características -->
    <string name="info_features_titulo">Características</string>
    <string name="info_feature_tablero">Tablero interactivo con piezas cburnett de Lichess</string>
    <string name="info_feature_planilla">Planilla electrónica con notación PGN estándar</string>
    <string name="info_feature_variantes">Soporte completo de variantes, comentarios y símbolos de evaluación (NAGs)</string>
    <string name="info_feature_pdf">Exportación a plantilla FIDE en PDF con figurín</string>
    <string name="info_feature_pgn">Importación y exportación en formato PGN interoperable</string>
    <string name="info_feature_torneos">Gestión de torneos con múltiples partidas</string>
    <string name="info_feature_temas">5 temas visuales seleccionables (Claro, Oscuro, Dinámico, Madera, Mármol)</string>
    <string name="info_feature_autosave">Guardado automático de todas las jugadas</string>
    <string name="info_feature_edicion">Edición de anotaciones y creación de variantes desde el tablero</string>
    <string name="info_feature_responsive">Diseño responsivo para todas las pantallas y orientaciones</string>

